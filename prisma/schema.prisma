generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRUSTED_DEV
  CONTRIBUTOR
}

enum RepoTier {
  CORE
  CORE_EXTRA
  EXTRA
  QCR
}

model User {
  id              String    @id @default(cuid())
  githubId        Int       @unique
  username        String
  avatarUrl       String
  githubCreatedAt DateTime
  role            Role      @default(CONTRIBUTOR)
  packages        Package[]
  createdAt       DateTime  @default(now())
}

model Package {
  id          String    @id @default(cuid())
  name        String    @unique
  version     String
  description String
  maintainer  String
  tier        RepoTier
  rawToml     String
  sha256      String
  blake3      String
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}